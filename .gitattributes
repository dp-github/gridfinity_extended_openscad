# Keep text files normalized in the repository so Windows/WSL edits do not
# produce full-file line-ending diffs.
*.scad text eol=lf
*.json text eol=lf
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf

# Vendored OpenSCAD sources have mixed upstream line endings. Do not normalize
# them unless we intentionally edit those files.
modules/polyround.scad -text -eol
modules/thirdparty/** -text -eol

# Rendered/model and raster assets should not be shown as text diffs.
*.stl binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
